#include <stdio.h>
#include <stdlib.h>
int main() {
    int h, c;
    printf("Nhap so hang va so cot: ");
    scanf("%d%d", &h, &c);
    if (h <= 0 || c <= 0) {
        printf("Kich thuoc khong hop le!\n");
        return 1;
    }
    float *ma = (float *)malloc(h * c * sizeof(float));
    if (ma == NULL) {
        printf("Khong du bo nho!\n");
        return 1;
    }
    for (int i = 0; i < h; i++) {
        for (int j = 0; j < c; j++) {
            printf("ma[%d][%d] = ", i, j);
            scanf("%f", ma + i * c + j);
        }
    }
    printf("Ma tran %dx%d vua tao:\n", h, c);
    for (int i = 0; i < h; i++) {
        for (int j = 0; j < c; j++) {
            printf("%.2f\t", *(ma + i * c + j));
        }
        printf("\n");
    }
    free(ma);

    return 0;
}
